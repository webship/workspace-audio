{
  "name": "@webship.co/workspace-audio",
  "version": "1.0.10",
  "description": "The Audio workspace for Webship Workspace: the `audio/` folder (type media), its settings file, its 1 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-audio.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "audio",
    "label": "Audio",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "workspace": {
      "key": "audio",
      "settingsTemplate": "config/workspace.audio.settings.yml",
      "files": [
        "commands/cmd-tools-voice.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/audio-voice-maker.md"
      ],
      "skills": [
        "ai/skills/audio-workflow"
      ],
      "commands": [
        "ai/commands/audio-speak.md"
      ],
      "prompts": [
        "ai/prompts/audio-narrate-a-text.md"
      ]
    },
    "features": [
      "features/audio.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
